@page
@model ManufacturingTimeTracking.Pages.Reports.TechnicianTaskComparisonModel
@{
    ViewData["Title"] = "Comparativa por técnico y tarea";
}

<div class="animate-fade-in max-w-6xl mx-auto p-4">
    <div class="mb-6 flex items-center justify-between">
        <h1 class="text-2xl font-semibold text-slate-800">Comparativa por técnico y tarea</h1>
        <form method="get" class="flex items-end gap-3">
            <div>
                <label class="block text-xs text-slate-500 mb-1">From</label>
                <input type="date" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 rounded-lg border" />
            </div>
            <div>
                <label class="block text-xs text-slate-500 mb-1">To</label>
                <input type="date" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="px-3 py-2 rounded-lg border" />
            </div>
            <div>
                <label class="block text-xs text-slate-500 mb-1">User</label>
                <select name="UserIdFilter" asp-items="Model.UserSelectList" class="px-3 py-2 rounded-lg border min-w-[200px]"></select>
            </div>
            <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 text-white">Apply</button>
        </form>
    </div>

    <div class="time-report-panel rounded-2xl p-4">
        @if (!Model.CompareRows.Any())
        {
            <p class="text-slate-600">No data for selected filters.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200 text-sm">
                    <thead class="bg-slate-100 text-left text-xs text-slate-700">
                        <tr>
                            <th class="px-3 py-2">Task</th>
                            <th class="px-3 py-2">Users (avg · runs)</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        @foreach (var row in Model.CompareRows)
                        {
                            <tr>
                                <td class="px-3 py-2 font-medium">@row.StepTitle</td>
                                <td class="px-3 py-2">
                                    <div class="flex flex-wrap gap-2">
                                        @foreach (var u in row.UserStats)
                                        {
                                            <span class="inline-flex items-center gap-2 px-3 py-1 rounded-full border bg-white text-sm">
                                                <strong>@u.UserDisplayName</strong>
                                            <span class="text-slate-600">· @TimeSpan.FromSeconds(u.AverageSeconds).ToString(@"hh\:mm\:ss")</span>
                                                <span class="text-slate-400">(@u.Runs)</span>
                                            </span>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>