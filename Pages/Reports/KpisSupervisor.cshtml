@page
@model ManufacturingTimeTracking.Pages.Reports.KpisSupervisorModel
@{
    ViewData["Title"] = "KPIs - Supervisor";
}

<style>
    /* Ensure readable text colors for KPI page */
    .kpi-page { color: #0f172a; }
    .kpi-page .input-dark {
        color: #e2e8f0;
        background: rgba(2,6,23,0.6);
        border: 1px solid rgba(56,189,248,0.45);
        border-radius: 0.75rem;
        padding: 0.5rem 0.75rem;
    }
    .kpi-page .btn-outline-luminous {
        background: transparent;
        border: none;
        color: #86efac;
        padding: 0.5rem 0.75rem;
        border-radius: 0.75rem;
        box-shadow: 0 0 0 1px rgba(56,189,248,0.55) inset, 0 0 18px rgba(56,189,248,0.2);
    }
    .kpi-page .btn-outline-luminous:hover {
        color: #bbf7d0;
        box-shadow: 0 0 0 1px rgba(56,189,248,0.85) inset, 0 0 24px rgba(56,189,248,0.35);
    }
    .kpi-filter-label { color: #86efac; }
</style>

<div class="animate-fade-in kpi-page">
    <h1 class="text-xl font-bold mb-4">KPIs (Supervisor)</h1>

    <div class="bg-white rounded-2xl shadow-soft p-4 mb-4">
        <form method="get" class="flex gap-3 items-end flex-wrap">
            <div>
                <label class="block text-sm kpi-filter-label">From</label>
                <input asp-for="FromDate" type="date" class="input-dark" />
            </div>
            <div>
                <label class="block text-sm kpi-filter-label">To</label>
                <input asp-for="ToDate" type="date" class="input-dark" />
            </div>
            <div>
                <label class="block text-sm kpi-filter-label">Model</label>
                <select asp-for="SelectedModelId" asp-items="Model.ModelSelectList" class="input-dark"></select>
            </div>
            <div>
                <button type="submit" class="btn-outline-luminous">Apply</button>
            </div>
        </form>
    </div>

    <style>
        /* Unified grid: 3 equal columns on large screens, 1 column on mobile */
        .kpi-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 1rem;
        }
        @@media (min-width: 1024px) {
            .kpi-grid {
                grid-template-columns: repeat(3, 1fr);
                grid-auto-rows: 210px;
            }
        }

        /* Cards fill their grid cell */
        .kpi-card {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: rgba(15,23,42,0.9);
            border: 1px solid rgba(125,211,252,0.35);
            border-radius: 1rem;
            box-shadow: 0 0 22px rgba(125,211,252,0.2);
            padding: 0.75rem;
        }
        .kpi-card h3 { margin-bottom: 0.25rem; font-weight: 600; font-size: 0.875rem; color: #f8fafc; }
        .kpi-card .kpi-desc { font-size: 0.75rem; color: #e2e8f0; margin-bottom: 0.25rem; }

        /* Chart container fills remaining space */
        .kpi-card .kpi-chart {
            flex: 1 1 auto;
            min-height: 100px;
            position: relative;
            background: rgba(2,6,23,0.6);
            border-radius: 0.75rem;
            border: 1px solid rgba(56,189,248,0.35);
            box-shadow: 0 0 18px rgba(56,189,248,0.15) inset;
        }
        .kpi-card .kpi-chart canvas {
            position: absolute;
            top: 0; left: 0;
            width: 100% !important;
            height: 100% !important;
        }
    </style>

    <!-- Row 1: Runs over target, Reworks, Blocks -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <h3>Runs over target (by Order)</h3>
            <div class="kpi-desc">Runs checked: <strong>@Model.RunsCheckedCount</strong>, with target: <strong>@Model.RunsWithTargetCount</strong></div>
            <div class="kpi-chart"><canvas id="chartOverTarget"></canvas></div>
        </div>
        <div class="kpi-card">
            <h3>Reworks (count by reason)</h3>
            <div class="kpi-desc">Reworks found: <strong>@Model.ReworksCount</strong></div>
            <div class="kpi-chart"><canvas id="chartReworks"></canvas></div>
        </div>
        <div class="kpi-card">
            <h3>Blocks (count by reason)</h3>
            <div class="kpi-desc">Blocks found: <strong>@Model.BlocksCount</strong></div>
            <div class="kpi-chart"><canvas id="chartBlocks"></canvas></div>
        </div>
    </div>

    <!-- Row 2: Weekly exceeded, Weekly reworks, Open orders -->
    <div class="kpi-grid" style="margin-top:1rem;">
        <div class="kpi-card">
            <h3>Weekly machines exceeding theoretical (12 weeks)</h3>
            <div class="kpi-desc">Executions: <strong>@Model.WeeklyExecutionsScanned</strong>, with theoretical: <strong>@Model.WeeklyExecutionsWithTheoretical</strong>, exceeded: <strong>@Model.WeeklyExecutionsExceeded</strong></div>
            <div class="kpi-chart"><canvas id="chartWeeklyExceeded"></canvas></div>
        </div>
        <div class="kpi-card">
            <h3>Weekly reworks (12 weeks)</h3>
            <div class="kpi-desc">Total reworks: <strong>@Model.WeeklyReworksTotal</strong></div>
            <div class="kpi-chart"><canvas id="chartWeeklyReworks"></canvas></div>
        </div>
        <div class="kpi-card">
            <h3>Open orders (not finished) — 12 weeks</h3>
            <div class="kpi-desc">Current open: <strong>@Model.WeeklyOpenOrdersTotal</strong></div>
            <div class="kpi-chart"><canvas id="chartWeeklyOpenOrders"></canvas></div>
        </div>
    </div>

    <!-- Details grid (shown when clicking on a chart bar) -->
    <div id="detailsPanel" class="mt-4" style="display:none;">
        <div class="bg-white rounded-xl shadow-soft p-4">
            <div class="flex justify-between items-center mb-3">
                <h4 id="detailsTitle" class="font-semibold text-slate-800"></h4>
                <button id="closeDetails" class="text-slate-400 hover:text-slate-600 text-xl">&times;</button>
            </div>
            <div id="detailsContent" class="overflow-x-auto"></div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    const overTarget = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverTargetSummary));
    const rework = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ReworkSummary));
    const blocks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BlockSummary));
    const overTargetDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverTargetDetails));
    const overTargetOrderIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.OverTargetOrderIds));
    const weeklyExceeded = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyExceededSummary));
    const weeklyExceededDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyExceededDetails));
    const weeklyReworks = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyReworksSummary));
    const weeklyReworksDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyReworksDetails));
    const weeklyOpenOrders = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyOpenOrdersSummary));
    const weeklyOpenOrdersDetails = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyOpenOrdersDetails));

    function createBar(ctx, labels, data, color) {
        return new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{ label: '', data: data, backgroundColor: color, maxBarThickness: 48 }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false }, tooltip: { mode: 'index', intersect: false } },
                scales: {
                    x: { ticks: { autoSkip: true, maxRotation: 0 }, grid: { display: false } },
                    y: { beginAtZero: true }
                }
            }
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        const detailsPanel = document.getElementById('detailsPanel');
        const detailsTitle = document.getElementById('detailsTitle');
        const detailsContent = document.getElementById('detailsContent');
        const closeDetails = document.getElementById('closeDetails');

        closeDetails.addEventListener('click', function() {
            detailsPanel.style.display = 'none';
        });

        function formatDur(sec) {
            if (!sec && sec !== 0) return '—';
            var s = Number(sec);
            if (isNaN(s)) return '—';
            var hours = Math.floor(s/3600); var mins = Math.floor((s%3600)/60); var secs = s%60;
            return String(hours).padStart(2,'0') + ':' + String(mins).padStart(2,'0') + ':' + String(secs).padStart(2,'0');
        }

        function showDetails(title, html) {
            detailsTitle.textContent = title;
            detailsContent.innerHTML = html;
            detailsPanel.style.display = 'block';
            detailsPanel.scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        // Chart 1: Over Target
        const ctx1 = document.getElementById('chartOverTarget').getContext('2d');
        const chart1 = createBar(ctx1, overTarget.labels || [], overTarget.values || [], 'rgba(239,68,68,0.8)');
        document.getElementById('chartOverTarget').addEventListener('click', function(evt) {
            const points = chart1.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, false);
            if (!points || points.length === 0) return;
            const idx = points[0].index;
            const details = (overTargetDetails && overTargetDetails[idx]) ? overTargetDetails[idx] : [];
            const label = (overTarget.labels && overTarget.labels[idx]) || '';
            if (!details || details.length === 0) { showDetails('Steps over target — ' + label, '<p class="text-slate-500">No details available.</p>'); return; }
            let html = '<table class="w-full text-sm"><thead class="bg-slate-100"><tr><th class="text-left p-2">Step</th><th class="text-left p-2">Duration</th><th class="text-left p-2">Target</th><th class="text-left p-2">Technician</th></tr></thead><tbody>';
            details.forEach(function(d) {
                html += '<tr class="border-b border-slate-100"><td class="p-2 font-medium">' + (d.StepTitle || '') + '</td><td class="p-2">' + (d.Duration || '') + '</td><td class="p-2">' + (d.Target || '') + '</td><td class="p-2">' + (d.Operator || '(unknown)') + '</td></tr>';
            });
            html += '</tbody></table>';
            showDetails('Steps over target — ' + label, html);
        });

        // Chart 2: Reworks (no details, just summary)
        const ctx2 = document.getElementById('chartReworks').getContext('2d');
        createBar(ctx2, rework.labels || [], rework.values || [], 'rgba(245,158,11,0.9)');

        // Chart 3: Blocks (no details, just summary)
        const ctx3 = document.getElementById('chartBlocks').getContext('2d');
        createBar(ctx3, blocks.labels || [], blocks.values || [], 'rgba(59,130,246,0.9)');

        // Chart 4: Weekly Exceeded
        const ctx4 = document.getElementById('chartWeeklyExceeded').getContext('2d');
        const chart4 = createBar(ctx4, weeklyExceeded.labels || [], weeklyExceeded.values || [], 'rgba(139,92,246,0.9)');
        document.getElementById('chartWeeklyExceeded').addEventListener('click', function(evt) {
            const points = chart4.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, false);
            if (!points || points.length === 0) return;
            const idx = points[0].index;
            const details = (weeklyExceededDetails && weeklyExceededDetails[idx]) ? weeklyExceededDetails[idx] : [];
            const weekLabel = (weeklyExceeded.labels && weeklyExceeded.labels[idx]) || '';
            if (!details || details.length === 0) { showDetails('Machines exceeded — Week ' + weekLabel, '<p class="text-slate-500">No details available.</p>'); return; }
            let html = '<table class="w-full text-sm"><thead class="bg-slate-100"><tr><th class="text-left p-2">Order</th><th class="text-left p-2">Actual</th><th class="text-left p-2">Theoretical</th><th class="text-left p-2">Steps exceeded</th></tr></thead><tbody>';
            details.forEach(function(d) {
                let stepsHtml = '';
                if (d.Steps && d.Steps.length) {
                    stepsHtml = '<ul class="text-xs text-slate-600 mt-1">';
                    d.Steps.forEach(function(s) {
                        var ops = (s.Operators && s.Operators.length) ? s.Operators.join(', ') : '(unknown)';
                        stepsHtml += '<li class="py-1 border-b border-dashed border-slate-200">' + s.StepTitle + ' — Actual: ' + formatDur(s.Actual) + ', Target: ' + formatDur(s.Theoretical) + ', Tech: ' + ops + '</li>';
                    });
                    stepsHtml += '</ul>';
                }
                html += '<tr class="border-b border-slate-100 align-top"><td class="p-2 font-medium">' + (d.Label || '') + '</td><td class="p-2">' + formatDur(d.Actual) + '</td><td class="p-2">' + formatDur(d.Theoretical) + '</td><td class="p-2">' + stepsHtml + '</td></tr>';
            });
            html += '</tbody></table>';
            showDetails('Machines exceeded — Week ' + weekLabel, html);
        });

        // Chart 5: Weekly Reworks
        const ctx5 = document.getElementById('chartWeeklyReworks').getContext('2d');
        const chart5 = createBar(ctx5, weeklyReworks.labels || [], weeklyReworks.values || [], 'rgba(16,185,129,0.9)');
        document.getElementById('chartWeeklyReworks').addEventListener('click', function(evt) {
            const points = chart5.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, false);
            if (!points || points.length === 0) return;
            const idx = points[0].index;
            const details = (weeklyReworksDetails && weeklyReworksDetails[idx]) ? weeklyReworksDetails[idx] : [];
            const weekLabel = (weeklyReworks.labels && weeklyReworks.labels[idx]) || '';
            if (!details || details.length === 0) { showDetails('Reworks — Week ' + weekLabel, '<p class="text-slate-500">No details available.</p>'); return; }
            let html = '<table class="w-full text-sm"><thead class="bg-slate-100"><tr><th class="text-left p-2">Order</th><th class="text-left p-2">Notes</th><th class="text-left p-2">Time</th></tr></thead><tbody>';
            details.forEach(function(d) {
                html += '<tr class="border-b border-slate-100"><td class="p-2 font-medium">' + (d.Label || '') + '</td><td class="p-2">' + (d.Notes || '(no reason)') + '</td><td class="p-2">' + new Date(d.Time).toLocaleString() + '</td></tr>';
            });
            html += '</tbody></table>';
            showDetails('Reworks — Week ' + weekLabel, html);
        });

        // Chart 6: Weekly Open Orders
        const ctx6 = document.getElementById('chartWeeklyOpenOrders').getContext('2d');
        const chart6 = createBar(ctx6, weeklyOpenOrders.labels || [], weeklyOpenOrders.values || [], 'rgba(249,115,22,0.9)');
        document.getElementById('chartWeeklyOpenOrders').addEventListener('click', function(evt) {
            const points = chart6.getElementsAtEventForMode(evt, 'nearest', { intersect: true }, false);
            if (!points || points.length === 0) return;
            const idx = points[0].index;
            const details = (weeklyOpenOrdersDetails && weeklyOpenOrdersDetails[idx]) ? weeklyOpenOrdersDetails[idx] : [];
            const weekLabel = (weeklyOpenOrders.labels && weeklyOpenOrders.labels[idx]) || '';
            if (!details || details.length === 0) { showDetails('Open orders — Week ' + weekLabel, '<p class="text-slate-500">No details available.</p>'); return; }
            let html = '<table class="w-full text-sm"><thead class="bg-slate-100"><tr><th class="text-left p-2">Order</th><th class="text-left p-2">Status</th><th class="text-left p-2">Created</th></tr></thead><tbody>';
            details.forEach(function(d) {
                html += '<tr class="border-b border-slate-100"><td class="p-2 font-medium">' + (d.Label || '') + '</td><td class="p-2">' + (d.Status || '') + '</td><td class="p-2">' + new Date(d.CreatedAt).toLocaleDateString() + '</td></tr>';
            });
            html += '</tbody></table>';
            showDetails('Open orders — Week ' + weekLabel, html);
        });
    });
</script>
