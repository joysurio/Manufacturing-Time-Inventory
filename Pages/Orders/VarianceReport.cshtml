@page
@model ManufacturingTimeTracking.Pages.Orders.VarianceReportModel
@{
    ViewData["Title"] = "Variance Report by Model";
}

<div class="animate-fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <h1 class="text-2xl font-bold text-slate-800">Variance Report by Model</h1>
        <a asp-page="./Index" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 w-fit">Back to Orders</a>
    </div>
    <p class="text-slate-500 mb-6">StandardHours vs avg RealHours per model (orders with activity in the selected date range). Identifies where variability comes from per model.</p>

    <form method="get" class="mb-6 flex flex-wrap items-end gap-4">
        <div>
            <label for="FromDate" class="block text-sm font-medium text-slate-700 mb-1">From date</label>
            <input type="date" id="FromDate" name="FromDate" value="@Model.FromDate?.ToString("yyyy-MM-dd")" class="px-4 py-2 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
        </div>
        <div>
            <label for="ToDate" class="block text-sm font-medium text-slate-700 mb-1">To date</label>
            <input type="date" id="ToDate" name="ToDate" value="@Model.ToDate?.ToString("yyyy-MM-dd")" class="px-4 py-2 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
        </div>
        <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700">Apply</button>
    </form>

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 overflow-hidden max-w-4xl mx-auto">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200 table-fixed w-full">
                <thead class="bg-slate-50/80">
                    <tr>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Model</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Sample size</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Avg Real (h)</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Standard (h)</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Variance %</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="5" class="px-6 py-8 text-center text-slate-500">No data for the selected date range.</td>
                        </tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="table-row-hover">
                            <td class="px-6 py-4 text-center font-medium text-slate-800">@row.ModelName</td>
                            <td class="px-6 py-4 text-center text-slate-600">@row.SampleSize</td>
                            <td class="px-6 py-4 text-center text-slate-800">@row.AvgRealHours.ToString("N2")</td>
                            <td class="px-6 py-4 text-center text-slate-600">@row.StandardHours.ToString("N2")</td>
                            <td class="px-6 py-4 text-center font-medium @(row.VariancePercent > 0 ? "text-amber-600" : row.VariancePercent < 0 ? "text-emerald-600" : "text-slate-600")">@row.VariancePercent.ToString("N1")%</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Pagination" />
    </div>
</div>
