@page "{id:int}"
@model ManufacturingTimeTracking.Pages.Orders.UnblockModel
@{
    ViewData["Title"] = "Unblock Order";
}

<div class="animate-fade-in max-w-xl">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Unblock Order</h1>
    <p class="text-slate-500 mb-6">Order <strong>@Model.ExternalRef</strong> — @Model.SerialNumber. You may add an optional note.</p>

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6">
        <form method="post" class="space-y-5">
            <div>
                <label asp-for="UnblockNote" class="block text-sm font-medium text-slate-700 mb-1.5">Note (optional)</label>
                <textarea asp-for="UnblockNote" rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" placeholder="e.g. Material received, issue resolved..."></textarea>
            </div>
            <div class="flex gap-3 pt-2">
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700">Unblock Order</button>
                <a asp-page="./Details" asp-route-id="@Model.OrderId" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</a>
            </div>
        </form>
    </div>
</div>
