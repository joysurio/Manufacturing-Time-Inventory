    <!-- Add run modal -->
    <div id="addRunModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-hidden="true">
        <div class="flex min-h-full items-center justify-center p-4">
            <div class="fixed inset-0 bg-slate-900/60" id="addRunBackdrop"></div>
            <div class="relative bg-white rounded-2xl shadow-xl border border-slate-200 p-6 w-full max-w-md">
                <h3 class="text-lg font-semibold text-slate-800 mb-4">Add step run</h3>
                <form method="post" asp-page-handler="AddRun" id="addRunForm">
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">User</label>
                            <select name="userId" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required>
                                @foreach (var kv in Model.UserDisplayNames)
                                {
                                    <option value="@kv.Key">@kv.Value</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Step</label>
                            <select name="stepExecId" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required>
                                @foreach (var opt in Model.StepOptions)
                                {
                                    <option value="@opt.StepExecId">@opt.Display</option>
                                }
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Started (local)</label>
                            <input type="datetime-local" name="startedLocal" id="addRunStarted" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-slate-700 mb-1">Finished (local)</label>
                            <input type="datetime-local" name="finishedLocal" id="addRunFinished" class="w-full px-4 py-2.5 rounded-xl border border-slate-300 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
                            <p class="mt-1 text-xs text-slate-500">Leave empty for an in-progress run.</p>
