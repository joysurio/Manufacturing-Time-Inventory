                    <div class="flex gap-2 justify-end mt-6">
                        <button type="button" id="addRunCancel" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</button>
                        <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700">Add</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
(function () {
    function initSearchableSelect(container) {
        if (!container) return;
        var trigger = container.querySelector('.select-trigger');
        var dropdown = container.querySelector('.select-dropdown');
        var filterInput = container.querySelector('.select-filter');
        var optionsList = container.querySelector('.select-options');
        var options = container.querySelectorAll('.select-option');
        var hiddenInput = container.querySelector('input[type="hidden"]');
        var triggerText = container.querySelector('.select-trigger-text');

        function open() {
            document.querySelectorAll('.searchable-select .select-dropdown').forEach(function (d) {
                if (d !== dropdown) d.classList.add('hidden');
            });
            dropdown.classList.remove('hidden');
            trigger.setAttribute('aria-expanded', 'true');
            filterInput.value = '';
            filterInput.focus();
            options.forEach(function (opt) { opt.style.display = ''; });
            // Ensure trigger text is populated immediately when opened so it's visible
            try {
                if (triggerText) {
                    var val = hiddenInput ? hiddenInput.value : null;
                    var found = null;
                    if (val) {
                        Array.prototype.forEach.call(options, function(o){ if (!found && o.getAttribute('data-value') === val) found = o; });
                    }
                    if (found) {
                        triggerText.textContent = found.textContent.trim();
                    } else if (hiddenInput && !hiddenInput.value) {
                        triggerText.textContent = (hiddenInput.name === 'UserIdFilter') ? '— All users —' : '— All orders —';
                    }
                }
            } catch (e) { /* ignore */ }
        }
        function close() {
            dropdown.classList.add('hidden');
            trigger.setAttribute('aria-expanded', 'false');
        }
        function choose(value, text) {
            if (hiddenInput) hiddenInput.value = value || '';
            if (triggerText) triggerText.textContent = text || (hiddenInput.name === 'UserIdFilter' ? '— All users —' : '— All orders —');
            close();
        }

        trigger.addEventListener('click', function (e) {
            e.preventDefault();
            if (dropdown.classList.contains('hidden')) open(); else close();
        });
        filterInput.addEventListener('input', function () {
            var q = (this.value || '').trim().toLowerCase();
            options.forEach(function (opt) {
                var show = !q || (opt.textContent || '').toLowerCase().indexOf(q) >= 0;
                opt.style.display = show ? '' : 'none';
            });
        });
        filterInput.addEventListener('click', function (e) { e.stopPropagation(); });
        options.forEach(function (opt) {
            opt.addEventListener('click', function (e) {
                e.stopPropagation();
                choose(this.getAttribute('data-value'), this.textContent);
            });
        });
        document.addEventListener('click', function (e) {
            if (!container.contains(e.target)) close();
        });
    }
    document.querySelectorAll('.searchable-select').forEach(initSearchableSelect);

    // Admin: edit / add run modals
    var editButtons = document.querySelectorAll('.edit-run-btn');
    var editModal = document.getElementById('editRunModal');
    if (editModal && editButtons.length) {
        var editId = document.getElementById('editRunId');
        var editStarted = document.getElementById('editRunStarted');
        var editFinished = document.getElementById('editRunFinished');
        editButtons.forEach(function(btn) {
            btn.addEventListener('click', function() {
                editId.value = this.getAttribute('data-id');
                editStarted.value = this.getAttribute('data-start') || '';
                editFinished.value = this.getAttribute('data-finish') || '';
                editModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
        });
        document.getElementById('editRunCancel').addEventListener('click', function() {
            editModal.classList.add('hidden');
            document.body.style.overflow = '';
        });
        document.getElementById('editRunBackdrop').addEventListener('click', function() {
            editModal.classList.add('hidden');
            document.body.style.overflow = '';
        });
    }

    var addBtn = document.getElementById('btnAddRun');
    var addModal = document.getElementById('addRunModal');
    if (addBtn && addModal) {
        addBtn.addEventListener('click', function() {
            var now = new Date();
            var y = now.getFullYear();
            var m = String(now.getMonth() + 1).padStart(2, '0');
            var d = String(now.getDate()).padStart(2, '0');
            var h = String(now.getHours()).padStart(2, '0');
            var min = String(now.getMinutes()).padStart(2, '0');
            var val = y + '-' + m + '-' + d + 'T' + h + ':' + min;
            var startedInput = document.getElementById('addRunStarted');
            if (startedInput) startedInput.value = val;
            addModal.classList.remove('hidden');
            document.body.style.overflow = 'hidden';
        });
        document.getElementById('addRunCancel').addEventListener('click', function() {
            addModal.classList.add('hidden');
            document.body.style.overflow = '';
        });
        document.getElementById('addRunBackdrop').addEventListener('click', function() {
            addModal.classList.add('hidden');
            document.body.style.overflow = '';
        });
    }
})();
</script>
<script>
document.getElementById('exportPdfBtn')?.addEventListener('click', function() {
    // Open a new window with a printable view of the report and trigger print-to-PDF in browser
    var url = window.location.pathname + window.location.search;
    var w = window.open(url + (url.indexOf('?') === -1 ? '?' : '&') + 'print=1', '_blank');
    if (!w) alert('Please allow popups to export PDF');
});
</script>
}
