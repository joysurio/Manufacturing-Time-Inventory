                    </div>
                    <div class="flex gap-2 justify-end mt-6">
                        <button type="button" id="editRunCancel" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</button>
                        <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700">Save</button>
