@page
@model ManufacturingTimeTracking.Pages.Orders.BlockagesModel
@{
    ViewData["Title"] = "Blockages";
}

<div class="animate-fade-in">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Blockages</h1>
            <p class="text-slate-500 mt-1">All order blockages and their reasons. <strong class="text-amber-600">@Model.ActiveCount active</strong>.</p>
        </div>
        <a asp-page="./Index" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 w-fit">Back to Orders</a>
    </div>

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 overflow-hidden">
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50/80">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Order</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Reason</th>
                        <th class="px-6 py-4 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Notes</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Blocked at</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Unblocked at</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Duration</th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @if (!Model.Rows.Any())
                    {
                        <tr>
                            <td colspan="7" class="px-6 py-8 text-center text-slate-500">No blockages recorded.</td>
                        </tr>
                    }
                    @foreach (var row in Model.Rows)
                    {
                        <tr class="table-row-hover @(row.IsActive ? "bg-amber-50/60" : "")">
                            <td class="px-6 py-4">
                                <a asp-page="./Details" asp-route-id="@row.OrderId" class="font-medium text-blue-600 hover:underline">@row.ExternalRef</a>
                                <div class="text-xs text-slate-500">@row.SerialNumber</div>
                            </td>
                            <td class="px-6 py-4 text-slate-700 font-medium">@row.ReasonName</td>
                            <td class="px-6 py-4 text-slate-600 text-sm max-w-xs truncate" title="@row.Notes">@row.Notes</td>
                            <td class="px-6 py-4 text-center text-slate-600 text-sm">@row.StartTime.ToString("g")</td>
                            <td class="px-6 py-4 text-center text-slate-600 text-sm">@(row.EndTime?.ToString("g") ?? "—")</td>
                            <td class="px-6 py-4 text-center text-slate-600 text-sm">
                                @{
                                    var end = row.EndTime ?? DateTime.UtcNow;
                                    var duration = end - row.StartTime;
                                }
                                @if (duration.TotalDays >= 1)
                                {
                                    @($"{(int)duration.TotalDays}d {duration.Hours}h")
                                }
                                else
                                {
                                    @duration.ToString(@"hh\:mm")
                                }
                            </td>
                            <td class="px-6 py-4 text-center">
                                @if (row.IsActive)
                                {
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-red-100 text-red-800">Active</span>
                                }
                                else
                                {
                                    <span class="inline-flex px-2.5 py-1 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800">Resolved</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <partial name="_Pagination" model="Model.Pagination" />
    </div>
</div>
