@page "{id:int}"
@model ManufacturingTimeTracking.Pages.MaterialSets.DeleteModel
@{
    ViewData["Title"] = "Delete Material Set";
}

<div class="animate-fade-in max-w-lg mx-auto">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Delete Material Set</h1>
    <p class="text-slate-500 mb-6">Are you sure you want to delete this set? This cannot be undone.</p>
    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6">
        <dl class="space-y-2">
            <dt class="text-sm font-medium text-slate-500">Name</dt>
            <dd class="font-medium text-slate-800">@Model.MaterialSet!.Name</dd>
            @if (!string.IsNullOrWhiteSpace(Model.MaterialSet.Description))
            {
                <dt class="text-sm font-medium text-slate-500">Description</dt>
                <dd class="text-slate-600">@Model.MaterialSet.Description</dd>
            }
            <dt class="text-sm font-medium text-slate-500">Materials</dt>
            <dd class="text-slate-600">
                @string.Join(", ", Model.MaterialSet.Items.OrderBy(i => i.SortOrder).Select(i => $"{i.Material?.Name ?? "?"} x{i.Quantity}"))
            </dd>
        </dl>
        <form method="post" class="flex gap-3 mt-6 pt-6 border-t border-slate-200">
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-red-600 text-white font-medium hover:bg-red-700">Delete</button>
            <a asp-page="./Index" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</a>
        </form>
    </div>
</div>
