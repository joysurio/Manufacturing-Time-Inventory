@page
@model ManufacturingTimeTracking.Pages.Tasks.DetailModel
@using ManufacturingTimeTracking.Models.Tasks
@{
    ViewData["Title"] = Model.Task?.Title ?? "Task";
    var clockInRequiredMessage = TempData["TasksClockInRequired"] as string;
    var statusText = Model.Task?.Status switch { TaskItemStatus.Open => "Open", TaskItemStatus.InProgress => "In progress", TaskItemStatus.Finished => "Finished", _ => "—" };
    // CTO issue #43: allow multiple users to start the same task concurrently.
    // For the current user, start is only allowed if they don't already have an active session.
    var canStart = Model.CanControlTask && (Model.Task?.Status == TaskItemStatus.Open || Model.Task?.Status == TaskItemStatus.InProgress) && Model.CurrentSession == null;
    var canPause = Model.CanControlTask && Model.Task?.Status == TaskItemStatus.InProgress && Model.CurrentSession != null && !Model.IsPaused;
    var canResume = Model.CanControlTask && Model.Task?.Status == TaskItemStatus.InProgress && Model.IsPaused;
    // Finish is scoped to the current user's active session.
    var canFinish = Model.CanControlTask && Model.Task?.Status == TaskItemStatus.InProgress && Model.CurrentSession != null;
}

<div class="animate-fade-in max-w-3xl mx-auto">
    <div class="mb-6">
        <a asp-page="./Index" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-all duration-200">← Tasks</a>
    </div>

    @if (TempData["TasksSuccess"] != null)
    {
        <div class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">@TempData["TasksSuccess"]</div>
    }
    @if (TempData["TasksError"] != null)
    {
        <div class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">@TempData["TasksError"]</div>
    }
    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6 mb-6">
        <h1 class="text-2xl font-bold text-slate-800 mb-1">@Model.Task?.Title</h1>
        <p class="text-slate-500 text-sm mb-4">
            <span class="inline-flex px-2 py-0.5 rounded text-xs font-medium
                @(Model.Task?.Status == TaskItemStatus.Open ? "bg-slate-100 text-slate-800" :
                  Model.Task?.Status == TaskItemStatus.InProgress ? "bg-amber-100 text-amber-800" : "bg-emerald-100 text-emerald-800")">@statusText</span>
            · Assigned to <strong>@Model.AssignedUserName</strong>
        </p>
        @if (!string.IsNullOrWhiteSpace(Model.Task?.Description))
        {
            <p class="text-slate-600 mb-4">@Model.Task.Description</p>
        }

        <div class="flex flex-wrap items-center gap-4 mb-6">
            <div>
                <span class="text-xs font-medium text-slate-500 uppercase">Total time spent</span>
                <p class="text-lg font-semibold text-slate-800">@FormatDuration(Model.TotalTimeSpent)</p>
            </div>
            @if (Model.CurrentSessionDuration.HasValue)
            {
                <div>
                    <span class="text-xs font-medium text-slate-500 uppercase">Current session</span>
                    <p class="text-lg font-semibold text-amber-700">@FormatDuration(Model.CurrentSessionDuration.Value)@(Model.IsPaused ? " (paused)" : "")</p>
                </div>
            }
        </div>

        @if (Model.CanControlTask && Model.Task?.Status != TaskItemStatus.Finished)
        {
            <div class="flex flex-wrap gap-3 border-t border-slate-200 pt-4">
                @if (canStart)
                {
                    <form method="post" asp-page-handler="Start" asp-route-id="@Model.Task!.Id">
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700">Start task</button>
                    </form>
                }
                @if (canPause)
                {
                    <form method="post" asp-page-handler="Pause" asp-route-id="@Model.Task!.Id">
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-amber-500 text-white font-medium hover:bg-amber-600">Pause</button>
                    </form>
                }
                @if (canResume)
                {
                    <form method="post" asp-page-handler="Resume" asp-route-id="@Model.Task!.Id">
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-sky-500 text-white font-medium hover:bg-sky-600">Resume</button>
                    </form>
                }
                @if (canFinish)
                {
                    <form method="post" asp-page-handler="Finish" asp-route-id="@Model.Task!.Id" onsubmit="return confirm('Finish this task?');">
                        <button type="submit" class="px-5 py-2.5 rounded-xl bg-slate-700 text-white font-medium hover:bg-slate-800">Finish task</button>
                    </form>
                }
            </div>
        }
    </div>

    @if (Model.SessionSummaries.Any())
    {
        <div class="bg-white rounded-2xl shadow-soft border border-slate-100 overflow-hidden">
            <div class="px-6 py-4 bg-slate-50/80 border-b border-slate-100">
                <h2 class="text-lg font-semibold text-slate-800">Work sessions</h2>
            </div>
            <div class="overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50/80">
                        <tr>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Started</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">Ended</th>
                            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">User</th>
                            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Duration</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-100">
                        @foreach (var s in Model.SessionSummaries.OrderByDescending(x => x.StartedAtUtc))
                        {
                            <tr class="hover:bg-slate-50/50">
                                <td class="px-4 py-3 text-slate-700">@s.StartedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")</td>
                                <td class="px-4 py-3 text-slate-700">@(s.EndedAtUtc?.ToLocalTime().ToString("yyyy-MM-dd HH:mm") ?? "—")</td>
                                <td class="px-4 py-3 text-slate-700">@s.UserName</td>
                                <td class="px-4 py-3 text-right font-medium text-slate-800">@FormatDuration(s.Duration)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@if (!string.IsNullOrEmpty(clockInRequiredMessage) && Model.Task != null)
{
    <div class="tw-modal fixed inset-0 z-[120] hidden" id="taskClockInRequiredModal" role="dialog" aria-labelledby="taskClockInRequiredModalTitle" aria-modal="true">
        <div class="fixed inset-0 bg-black/50" data-modal-close></div>
        <div class="fixed left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-lg max-h-[90vh] overflow-auto rounded-2xl shadow-xl bg-white border border-amber-200 z-10">
            <div class="flex items-center justify-between p-3 bg-amber-50 border-b border-amber-200">
                <h2 class="text-lg font-semibold text-amber-900" id="taskClockInRequiredModalTitle">Clock-in required</h2>
                <button type="button" class="p-2 rounded-lg text-slate-500 hover:bg-amber-100" data-modal-close aria-label="Close">&times;</button>
            </div>
            <div class="p-6">
                <p class="text-slate-700 mb-4">@clockInRequiredMessage</p>
                <form method="post" asp-page="/TimeTracking/Index" asp-page-handler="ClockIn" class="flex flex-wrap items-center gap-3">
                    <input type="hidden" name="returnUrl" value="@Url.Page("/Tasks/Detail", new { id = Model.Task.Id })" />
                    <button type="submit" class="p-2.5 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-emerald-500 focus:ring-offset-2">Clock in now</button>
                    <button type="button" class="p-2.5 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50" data-modal-close>Close</button>
                </form>
            </div>
        </div>
    </div>
    <script>
        (function () {
            var modalId = 'taskClockInRequiredModal';
            var modalEl = document.getElementById(modalId);
            if (!modalEl) return;

            if (window.showModal) {
                window.showModal(modalId);
                return;
            }

            modalEl.classList.remove('hidden');
            document.body.classList.add('overflow-hidden');

            var closeNodes = modalEl.querySelectorAll('[data-modal-close]');
            var closeModal = function () {
                modalEl.classList.add('hidden');
                document.body.classList.remove('overflow-hidden');
            };
            for (var i = 0; i < closeNodes.length; i++) {
                closeNodes[i].addEventListener('click', closeModal);
            }
        })();
    </script>
}

@functions {
    static string FormatDuration(TimeSpan t)
    {
        if (t.TotalHours >= 1)
            return $"{(int)t.TotalHours}h {t.Minutes}m";
        if (t.TotalMinutes >= 1)
            return $"{t.Minutes}m";
        return t.TotalSeconds > 0 ? $"{t.Seconds}s" : "—";
    }
}
