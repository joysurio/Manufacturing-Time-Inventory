@page
@model ManufacturingTimeTracking.Pages.TimeTracking.EditRecordsModel
@{
    ViewData["Title"] = "Edit Time Tracking Records (Admin)";
    var fromStr = Model.FromDate?.ToString("yyyy-MM-dd") ?? "";
    var toStr = Model.ToDate?.ToString("yyyy-MM-dd") ?? "";
}

<div class="animate-fade-in">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
        <a asp-page="./Index" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-all duration-200">← Time tracking</a>
        <a asp-page="./DetailedReport" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-all duration-200">Detailed report</a>
    </div>

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6 mb-6">
        <h1 class="text-2xl font-bold text-slate-800 mb-1">Edit Time Tracking Records</h1>
        <p class="text-slate-500 text-sm mb-6">Admin only. Correct or add clock-in/out and break entries. Changes automatically update reports.</p>

        @if (TempData["EditRecordsSuccess"] != null)
        {
            <div class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm">@TempData["EditRecordsSuccess"]</div>
        }
        @if (TempData["EditRecordsError"] != null)
        {
            <div class="mb-4 p-3 rounded-xl bg-red-50 border border-red-200 text-red-800 text-sm">@TempData["EditRecordsError"]</div>
        }

        <form method="get" class="grid grid-cols-1 md:grid-cols-12 gap-4 items-end mb-6">
            <div class="md:col-span-3">
                <label class="block text-sm font-medium text-slate-700 mb-1.5">From date</label>
                <input type="date" name="FromDate" value="@fromStr" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
            </div>
            <div class="md:col-span-3">
                <label class="block text-sm font-medium text-slate-700 mb-1.5">To date</label>
                <input type="date" name="ToDate" value="@toStr" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
            </div>
            <div class="md:col-span-4">
                <label class="block text-sm font-medium text-slate-700 mb-1.5">User</label>
                <select name="UserIdFilter" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" asp-items="Model.UserSelectList"></select>
            </div>
            <div class="md:col-span-2">
                <button type="submit" class="w-full px-5 py-3 rounded-xl bg-blue-600 text-white font-semibold hover:bg-blue-700">Apply</button>
            </div>
        </form>

        <div class="flex justify-end mb-4">
            <button type="button" id="btnAddEntry" class="inline-flex items-center px-4 py-2 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700">+ Add entry</button>
        </div>

        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50/80">
                    <tr>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                            <a asp-page="./EditRecords"
                               asp-route-FromDate="@fromStr"
                               asp-route-ToDate="@toStr"
                               asp-route-UserIdFilter="@Model.UserIdFilter"
                               asp-route-SortBy="User"
                               asp-route-SortDesc="@(Model.SortBy == "User" ? !Model.SortDesc : false)"
                               class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-700">
                                User
                            </a>
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                            <a asp-page="./EditRecords"
                               asp-route-FromDate="@fromStr"
                               asp-route-ToDate="@toStr"
                               asp-route-UserIdFilter="@Model.UserIdFilter"
                               asp-route-SortBy="Action"
                               asp-route-SortDesc="@(Model.SortBy == "Action" ? !Model.SortDesc : false)"
                               class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-700">
                                Action
                            </a>
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                            <a asp-page="./EditRecords"
                               asp-route-FromDate="@fromStr"
                               asp-route-ToDate="@toStr"
                               asp-route-UserIdFilter="@Model.UserIdFilter"
                               asp-route-SortBy="DateTime"
                               asp-route-SortDesc="@(Model.SortBy == "DateTime" ? !Model.SortDesc : false)"
                               class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-700">
                                Date &amp; time (local)
                            </a>
                        </th>
                        <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase">
                            <a asp-page="./EditRecords"
                               asp-route-FromDate="@fromStr"
                               asp-route-ToDate="@toStr"
                               asp-route-UserIdFilter="@Model.UserIdFilter"
                               asp-route-SortBy="BreakReason"
                               asp-route-SortDesc="@(Model.SortBy == "BreakReason" ? !Model.SortDesc : false)"
                               class="inline-flex items-center gap-1 text-slate-500 hover:text-slate-700">
                                Break reason
                            </a>
                        </th>
                        <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var e in Model.Entries)
                    {
                        <tr class="hover:bg-slate-50/50">
                            <td class="px-4 py-3 text-slate-800">@e.UserDisplayName</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex px-2 py-0.5 rounded text-xs font-medium
                                    @(e.ActionType == "CLOCK_IN" ? "bg-emerald-100 text-emerald-800" :
                                      e.ActionType == "CLOCK_OUT" ? "bg-slate-200 text-slate-800" :
                                      e.ActionType == "BREAK_START" ? "bg-amber-100 text-amber-800" : "bg-sky-100 text-sky-800")">@e.ActionType.Replace("_", " ")</span>
                            </td>
                            <td class="px-4 py-3 text-slate-700">@e.TimestampLocal</td>
                            <td class="px-4 py-3 text-slate-600">@(e.BreakReasonName ?? "—")</td>
                            <td class="px-4 py-3 text-right">
                                <button type="button" class="edit-btn inline-flex px-3 py-1.5 rounded-lg border border-blue-600 text-blue-600 text-sm font-medium hover:bg-blue-50 mr-2"
                                    data-id="@e.Id" data-action="@e.ActionType" data-timestamp="@e.TimestampLocalForInput" data-breakreasonid="@(e.BreakReasonId?.ToString() ?? "")">Edit</button>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@e.Id" class="inline" onsubmit="return confirm('Delete this record?');">
                                    <input type="hidden" name="FromDate" value="@fromStr" />
                                    <input type="hidden" name="ToDate" value="@toStr" />
                                    <input type="hidden" name="UserIdFilter" value="@Model.UserIdFilter" />
                                    <button type="submit" class="inline-flex px-3 py-1.5 rounded-lg border border-red-600 text-red-600 text-sm font-medium hover:bg-red-50">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (!Model.Entries.Any())
        {
            <p class="text-slate-500 py-6 text-center">No entries in the selected range. Adjust dates or user, or add an entry.</p>
        }
    </div>
</div>

<!-- Edit modal -->
<div id="editModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-hidden="true">
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" id="editModalBackdrop"></div>
        <div class="relative bg-white rounded-2xl shadow-xl border border-slate-200 p-6 w-full max-w-md">
            <h3 class="text-lg font-semibold text-slate-800 mb-4">Edit record</h3>
            <form method="post" asp-page-handler="Edit" id="editForm">
                <input type="hidden" name="id" id="editId" value="" />
                <input type="hidden" name="FromDate" value="@fromStr" />
                <input type="hidden" name="ToDate" value="@toStr" />
                <input type="hidden" name="UserIdFilter" value="@Model.UserIdFilter" />
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Date & time (local)</label>
                        <input type="datetime-local" name="timestampLocal" id="editTimestamp" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required />
                    </div>
                    <div id="editBreakReasonWrap" class="hidden">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Break reason</label>
                        <select name="breakReasonId" id="editBreakReasonId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                            <option value="">— Select —</option>
                            @foreach (var r in Model.BreakReasons)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="flex gap-2 justify-end mt-6">
                    <button type="button" id="editModalCancel" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Add entry modal -->
<div id="addModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-hidden="true">
    <div class="flex min-h-full items-center justify-center p-4">
        <div class="fixed inset-0 bg-slate-900/50" id="addModalBackdrop"></div>
        <div class="relative bg-white rounded-2xl shadow-xl border border-slate-200 p-6 w-full max-w-md">
            <h3 class="text-lg font-semibold text-slate-800 mb-4">Add entry</h3>
            <form method="post" asp-page-handler="Add" id="addForm">
                <input type="hidden" name="FromDate" value="@fromStr" />
                <input type="hidden" name="ToDate" value="@toStr" />
                <input type="hidden" name="UserIdFilter" value="@Model.UserIdFilter" />
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">User <span class="text-red-500">*</span></label>
                        <div class="relative">
                            <input type="text"
                                   id="addUserSearch"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 text-sm"
                                   placeholder="Type to search user by name or email..." autocomplete="off" />
                            <input type="hidden" name="userId" id="addUserId" />
                            <div id="addUserList"
                                 class="absolute left-0 right-0 mt-1 max-h-64 overflow-y-auto rounded-xl border border-slate-200 bg-white shadow-lg z-50 hidden">
                                @foreach (var opt in Model.AddUserSelectList)
                                {
                                    <button type="button"
                                            class="user-option w-full text-left px-4 py-2.5 text-sm text-slate-800 hover:bg-blue-50 border-b border-slate-100 last:border-b-0"
                                            data-value="@opt.Value"
                                            data-text="@opt.Text">
                                        @opt.Text
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Action <span class="text-red-500">*</span></label>
                        <select name="actionType" id="addActionType" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required>
                            <option value="CLOCK_IN">Clock In</option>
                            <option value="CLOCK_OUT">Clock Out</option>
                            <option value="BREAK_START">Break Start</option>
                            <option value="BREAK_END">Break End</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-slate-700 mb-1">Date & time (local) <span class="text-red-500">*</span></label>
                        <input type="datetime-local" name="timestampLocal" id="addTimestamp" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" required />
                    </div>
                    <div id="addBreakReasonWrap">
                        <label class="block text-sm font-medium text-slate-700 mb-1">Break reason (for Break Start)</label>
                        <select name="breakReasonId" id="addBreakReasonId" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20">
                            <option value="">— Select —</option>
                            @foreach (var r in Model.BreakReasons)
                            {
                                <option value="@r.Id">@r.Name</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="flex gap-2 justify-end mt-6">
                    <button type="button" id="addModalCancel" class="px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</button>
                    <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-600 text-white font-medium hover:bg-emerald-700">Add</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function() {
            var editModal = document.getElementById('editModal');
            var editForm = document.getElementById('editForm');
            var editId = document.getElementById('editId');
            var editTimestamp = document.getElementById('editTimestamp');
            var editBreakReasonWrap = document.getElementById('editBreakReasonWrap');
            var editBreakReasonId = document.getElementById('editBreakReasonId');

            document.querySelectorAll('.edit-btn').forEach(function(btn) {
                btn.addEventListener('click', function() {
                    var id = this.getAttribute('data-id');
                    var action = this.getAttribute('data-action');
                    var timestamp = this.getAttribute('data-timestamp');
                    var breakReasonId = this.getAttribute('data-breakreasonid') || '';
                    editId.value = id;
                    if (timestamp && timestamp.length >= 16)
                        editTimestamp.value = timestamp.slice(0, 16);
                    else
                        editTimestamp.value = '';
                    editBreakReasonWrap.classList.toggle('hidden', action !== 'BREAK_START');
                    editBreakReasonId.value = breakReasonId;
                    editModal.classList.remove('hidden');
                    document.body.style.overflow = 'hidden';
                });
            });

            function closeEditModal() {
                editModal.classList.add('hidden');
                document.body.style.overflow = '';
            }
            document.getElementById('editModalBackdrop').addEventListener('click', closeEditModal);
            document.getElementById('editModalCancel').addEventListener('click', closeEditModal);

            var addModal = document.getElementById('addModal');
            var addForm = document.getElementById('addForm');
            var addActionType = document.getElementById('addActionType');
            var addBreakReasonWrap = document.getElementById('addBreakReasonWrap');
            document.getElementById('btnAddEntry').addEventListener('click', function() {
                var now = new Date();
                var y = now.getFullYear(), m = String(now.getMonth() + 1).padStart(2, '0'), d = String(now.getDate()).padStart(2, '0');
                var h = String(now.getHours()).padStart(2, '0'), min = String(now.getMinutes()).padStart(2, '0');
                document.getElementById('addTimestamp').value = y + '-' + m + '-' + d + 'T' + h + ':' + min;
                addModal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            });
            addActionType.addEventListener('change', function() {
                addBreakReasonWrap.classList.toggle('hidden', this.value !== 'BREAK_START');
            });
            addBreakReasonWrap.classList.toggle('hidden', addActionType.value !== 'BREAK_START');

            function closeAddModal() {
                addModal.classList.add('hidden');
                document.body.style.overflow = '';
            }
            document.getElementById('addModalBackdrop').addEventListener('click', closeAddModal);
            document.getElementById('addModalCancel').addEventListener('click', closeAddModal);

            addForm.addEventListener('submit', function() {
                if (!document.getElementById('addUserId').value) {
                    alert('Please select a user.');
                    return false;
                }
                if (addActionType.value === 'BREAK_START' && !document.getElementById('addBreakReasonId').value) {
                    alert('Please select a break reason for Break Start.');
                    return false;
                }
            });

            // Searchable user list in Add entry modal
            (function() {
                var searchInput = document.getElementById('addUserSearch');
                var hiddenUserId = document.getElementById('addUserId');
                var list = document.getElementById('addUserList');
                if (!searchInput || !hiddenUserId || !list) return;

                var options = Array.from(list.querySelectorAll('.user-option')).map(function(btn) {
                    return {
                        btn: btn,
                        value: btn.getAttribute('data-value') || '',
                        text: (btn.getAttribute('data-text') || '').toLowerCase()
                    };
                });

                function filterUsers(query) {
                    var q = (query || '').toLowerCase().trim();
                    var anyVisible = false;
                    options.forEach(function(o) {
                        var match = !q || o.text.indexOf(q) !== -1;
                        o.btn.classList.toggle('hidden', !match);
                        if (match) anyVisible = true;
                    });
                    list.classList.toggle('hidden', !anyVisible);
                }

                options.forEach(function(o) {
                    o.btn.addEventListener('click', function() {
                        hiddenUserId.value = o.value;
                        searchInput.value = this.getAttribute('data-text') || '';
                        list.classList.add('hidden');
                    });
                });

                searchInput.addEventListener('input', function() {
                    hiddenUserId.value = '';
                    filterUsers(this.value);
                });

                searchInput.addEventListener('focus', function() {
                    filterUsers(this.value);
                });

                document.addEventListener('click', function(e) {
                    if (!e.target.closest('#addUserList') && !e.target.closest('#addUserSearch')) {
                        list.classList.add('hidden');
                    }
                });
            })();
        })();
    </script>
}
