@page
@model ManufacturingTimeTracking.Pages.TimeTracking.BreakReasons.EditModel
@{
    ViewData["Title"] = "Edit Break Reason";
}

<div class="animate-fade-in max-w-xl mx-auto">
    <div class="mb-6">
        <a asp-page="./Index" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-all duration-200">← Break Reasons</a>
    </div>

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6">
        <h1 class="text-2xl font-bold text-slate-800 mb-6">Edit break reason</h1>

        <form method="post">
            <div class="mb-5">
                <label asp-for="Input.Name" class="block text-sm font-medium text-slate-700 mb-1.5">Name <span class="text-red-500">*</span></label>
                <input asp-for="Input.Name" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
                <span asp-validation-for="Input.Name" class="text-red-600 text-sm mt-1 block"></span>
            </div>
            <div class="mb-5">
                <label asp-for="Input.Description" class="block text-sm font-medium text-slate-700 mb-1.5">Description (optional)</label>
                <input asp-for="Input.Description" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20" />
            </div>
            <div class="mb-6">
                <label class="inline-flex items-center gap-2 cursor-pointer">
                    <input asp-for="Input.Active" type="checkbox" class="rounded border-slate-300 text-blue-600 focus:ring-blue-500" />
                    <span class="text-sm font-medium text-slate-700">Active (shown in Time Tracking)</span>
                </label>
            </div>
            <div class="flex gap-3">
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700">Save</button>
                <a asp-page="./Index" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Cancel</a>
            </div>
        </form>
    </div>
</div>
