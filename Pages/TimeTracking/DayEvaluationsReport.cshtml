@page
@model ManufacturingTimeTracking.Pages.TimeTracking.DayEvaluationsReportModel
@{
    ViewData["Title"] = "Day evaluations (clock-out summary)";
    var today = DateTime.UtcNow.Date;
    var daysFromMonday = ((int)today.DayOfWeek + 6) % 7; // Monday=0
    var monday = today.AddDays(-daysFromMonday);
    var from = Model.FromDate ?? monday;
    var to = Model.ToDate ?? today;
    var isAdmin = User.IsInRole("Admin");
}
<style>
    input[type="date"].report-filter-control,
    select.report-filter-control,
    select.report-filter-control option {
        color: #000 !important;
    }
</style>
<div class="animate-fade-in max-w-6xl mx-auto p-4">
    <div class="mb-6 flex flex-wrap items-center gap-3">
        <a asp-page="./Index" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">← Time Tracking</a>
        <a asp-page="./Report" class="inline-flex items-center px-4 py-2 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50">Time report</a>
    </div>

    <h1 class="text-2xl font-bold text-slate-800 mb-1">Day evaluations</h1>
    <p class="text-slate-600 text-sm mb-6">"Resumen del día" icons and scores saved at clock-out. Filter by date range and user.</p>

    @if (!string.IsNullOrEmpty(Model.RecalcMessage))
    {
        <div class="mb-4 p-3 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-800 text-sm font-medium">
            ✔ @Model.RecalcMessage
        </div>
    }

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <div class="mt-6 flex items-center justify-center gap-2">
            <a class="px-3 py-1 rounded border bg-white text-slate-700 hover:bg-slate-50"
               asp-page="./DayEvaluationsReport"
               asp-route-FromDate="@(from.ToString("yyyy-MM-dd"))"
               asp-route-ToDate="@(to.ToString("yyyy-MM-dd"))"
               asp-route-UserIdFilter="@Model.UserIdFilter"
               asp-route-Page="@(Math.Max(1, Model.Page-1))">Previous</a>

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.Page)
                {
                    <span class="px-3 py-1 rounded border bg-slate-200 text-slate-900 font-semibold">@p</span>
                }
                else
                {
                    <a class="px-3 py-1 rounded border bg-white text-slate-700 hover:bg-slate-50"
                       asp-page="./DayEvaluationsReport"
                       asp-route-FromDate="@(from.ToString("yyyy-MM-dd"))"
                       asp-route-ToDate="@(to.ToString("yyyy-MM-dd"))"
                       asp-route-UserIdFilter="@Model.UserIdFilter"
                       asp-route-Page="@p">@p</a>
                }
            }

            <a class="px-3 py-1 rounded border bg-white text-slate-700 hover:bg-slate-50"
               asp-page="./DayEvaluationsReport"
               asp-route-FromDate="@(from.ToString("yyyy-MM-dd"))"
               asp-route-ToDate="@(to.ToString("yyyy-MM-dd"))"
               asp-route-UserIdFilter="@Model.UserIdFilter"
               asp-route-Page="@(Math.Min(Model.TotalPages, Model.Page+1))">Next</a>
        </div>
    }



    <form method="get" class="flex flex-wrap items-end gap-4 mb-4 bg-white rounded-2xl border border-slate-100 p-4 shadow-soft">
        <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">From</label>
            <input type="date" name="FromDate" value="@from.ToString("yyyy-MM-dd")" class="report-filter-control px-3 py-2 rounded-lg border border-slate-200 text-black bg-white" style="color:#000 !important;" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">To</label>
            <input type="date" name="ToDate" value="@to.ToString("yyyy-MM-dd")" class="report-filter-control px-3 py-2 rounded-lg border border-slate-200 text-black bg-white" style="color:#000 !important;" />
        </div>
        <div>
            <label class="block text-xs font-medium text-slate-500 mb-1">User</label>
            <select name="UserIdFilter" asp-items="Model.UserSelectList" class="report-filter-control px-3 py-2 rounded-lg border border-slate-200 min-w-[200px] text-black bg-white" style="color:#000 !important;"></select>
        </div>
        <button type="submit" class="px-4 py-2 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700">Apply</button>
        <a asp-page="./DayEvaluationsReport" class="px-4 py-2 rounded-xl bg-slate-100 text-slate-700 font-medium hover:bg-slate-200" 
           asp-route-FromDate="@(from.ToString("yyyy-MM-dd"))" asp-route-ToDate="@(to.ToString("yyyy-MM-dd"))" asp-route-UserIdFilter="@Model.UserIdFilter" asp-route-IncludeLive="true">Include live</a>
    </form>

    @if (isAdmin)
    {
        <form method="post" asp-page-handler="Recalculate"
              class="mb-6 flex flex-wrap items-center gap-3 bg-amber-50 border border-amber-200 rounded-2xl p-4">
            <input type="hidden" name="FromDate" value="@from.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="ToDate" value="@to.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="UserIdFilter" value="@Model.UserIdFilter" />
            <div class="flex-1 min-w-0">
                <p class="text-sm font-semibold text-amber-800">Re-fetch tasks from external API</p>
                <p class="text-xs text-amber-700 mt-0.5">Re-computes <strong>Tareas %</strong> using the same KPI as <strong>ReportTimeByUser</strong> (user time / max user time for that day).</p>
            </div>
            <button type="submit"
                    onclick="return confirm('Recalculate all evaluations in the selected range? This will overwrite stored scores.')"
                    class="px-4 py-2 rounded-xl bg-amber-600 hover:bg-amber-700 text-white font-semibold text-sm shrink-0">
                Recalculate
            </button>
        </form>
    }

    @if (!Model.Rows.Any())
    {
        <p class="text-slate-500 py-8 text-center">No saved evaluations in this period. Evaluations are stored when users clock out.</p>
    }
    else
    {
        <div class="space-y-6">
            @foreach (var row in Model.Rows)
            {
                <div class="bg-white rounded-2xl border border-slate-100 shadow-soft overflow-hidden">
                    <div class="px-4 py-3 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2 bg-slate-50/80">
                        <div class="font-medium text-slate-800">@row.UserDisplay</div>
                        <div class="text-sm text-slate-600">
                            <span class="font-medium">Day (UTC):</span> @row.EvalDateUtc.ToString("yyyy-MM-dd")
                            · <span class="font-medium">Average:</span> @Math.Round(row.AverageScore * 100)%
                            · <span class="font-medium">Saved:</span> @row.RecordedAtUtc.ToLocalTime().ToString("g")
                        </div>
                    </div>
                    <div class="p-4 overflow-x-auto">
                        @Html.Raw(row.SummaryHtml)
                        <div class="mt-3 text-sm text-slate-600">
                            @{ var workSumMin = (row.WorkSecondsSum / 60); var breakMin = (row.BreakSecondsTotal / 60); var overlapMin = (row.BreakOverlapSeconds / 60); var netMin = (row.NetWorkedSeconds / 60); var taskMin = (row.TaskSeconds / 60); }
                            <div><strong>Detalle (min):</strong> Trabajo sumado: <strong>@workSumMin</strong>m · Descanso total: <strong>@breakMin</strong>m · Descanso sobrepuesto a trabajo: <strong>@overlapMin</strong>m · Trabajo neto: <strong>@netMin</strong>m · Tareas: <strong>@taskMin</strong>m (@(Math.Round((row.TaskSeconds*100.0)/(7*60+40),1))%)</div>
                            <div class="mt-1 text-xs text-slate-500">Fórmula: Trabajo neto = suma(segundos trabajo) − intersección(descansos ∩ trabajo)</div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
