@page
@model ManufacturingTimeTracking.Pages.AI.Prompts.PromptsIndexModel
@{
    ViewData["Title"] = "AI Prompts";
}

<div class="max-w-5xl mx-auto animate-slide-up">
    <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-violet-600 flex items-center justify-center text-white shrink-0">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/></svg>
            </div>
            <div>
                <h1 class="text-2xl font-bold text-slate-800">AI Prompts</h1>
                <p class="text-sm text-slate-500 mt-0.5">Manage GPT prompt templates stored in the database</p>
            </div>
        </div>
        <a asp-page="/AI/ActivityReport" class="text-sm text-slate-500 hover:text-violet-600 transition-colors">← Back to AI</a>
    </div>

    <!-- Existing prompts -->
    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 mb-8">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="font-semibold text-slate-800">Stored Prompts</h2>
        </div>
        @if (!Model.Prompts.Any())
        {
            <div class="px-6 py-10 text-center text-slate-400 text-sm">No prompts yet. Add one below.</div>
        }
        else
        {
            <div class="divide-y divide-slate-100">
                @foreach (var p in Model.Prompts)
                {
                    <div class="px-6 py-4 flex items-start justify-between gap-4">
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center gap-2 mb-1">
                                <span class="font-semibold text-slate-800 text-sm">@p.Name</span>
                                @if (!string.IsNullOrEmpty(p.Description))
                                {
                                    <span class="text-xs text-slate-400">— @p.Description</span>
                                }
                            </div>
                            <p class="text-xs text-slate-500 line-clamp-2 font-mono bg-slate-50 rounded px-2 py-1 mt-1">@p.PromptText[..Math.Min(200, p.PromptText.Length)]@(p.PromptText.Length > 200 ? "…" : "")</p>
                            <p class="text-xs text-slate-400 mt-1">Last updated: @p.LastUpdate.ToString("yyyy-MM-dd HH:mm") UTC</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <a asp-page="./Edit" asp-route-id="@p.Id"
                               class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-slate-100 hover:bg-blue-50 hover:text-blue-700 text-slate-600 text-xs font-medium transition-colors">
                                Edit
                            </a>
                            <form method="post" asp-page-handler="Delete" asp-route-id="@p.Id"
                                  onsubmit="return confirm('Delete prompt \'@p.Name\'?');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="inline-flex items-center gap-1 px-3 py-1.5 rounded-lg bg-red-50 hover:bg-red-100 text-red-600 text-xs font-medium transition-colors">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    <!-- Add new prompt -->
    <div class="bg-white rounded-2xl shadow-soft border border-slate-100">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="font-semibold text-slate-800">Add New Prompt</h2>
        </div>
        <form method="post" asp-page-handler="Create" class="px-6 py-5 space-y-4">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Name <span class="text-red-400">*</span></label>
                    <input asp-for="Input.Name" placeholder="e.g. Prompt_Template_Report"
                           class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-400" />
                    <p class="text-xs text-slate-400 mt-1">This name is referenced in code. Use underscores, no spaces.</p>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Description</label>
                    <input asp-for="Input.Description" placeholder="Brief description of this prompt's purpose"
                           class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-violet-400" />
                </div>
            </div>
            <div>
                <label class="block text-xs font-medium text-slate-500 mb-1">Prompt Text <span class="text-red-400">*</span></label>
                <p class="text-xs text-slate-400 mb-2">Use <code class="bg-slate-100 px-1 rounded">{DATA}</code> as placeholder — it will be replaced with the actual data before sending to GPT.</p>
                <textarea asp-for="Input.PromptText" rows="8" placeholder="You are an expert analyst. Analyze the following data:&#10;&#10;{DATA}&#10;&#10;Provide a structured report…"
                          class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-violet-400 resize-y"></textarea>
            </div>
            <div>
                <button type="submit"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-violet-600 hover:bg-violet-700 text-white text-sm font-semibold transition-colors shadow-sm">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                    Add Prompt
                </button>
            </div>
        </form>
    </div>
</div>
