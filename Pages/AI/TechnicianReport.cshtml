@page
@model ManufacturingTimeTracking.Pages.AI.TechnicianReportModel
@{
    ViewData["Title"] = "Technician Improvement Report";
}

<div class="max-w-5xl mx-auto animate-slide-up">
    <div class="flex items-center gap-3 mb-6">
        <div class="w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white shrink-0">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
        </div>
        <div>
            <h1 class="text-2xl font-bold text-slate-800">Technician Improvement Report</h1>
            <p class="text-sm text-slate-500 mt-0.5">AI-powered performance analysis and improvement recommendations</p>
        </div>
    </div>

    @if (!Model.GptConfigured)
    {
        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-6 flex items-start gap-3">
            <svg class="w-5 h-5 text-amber-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
            <div>
                <p class="font-medium text-amber-800">OpenAI API key not configured</p>
                <p class="text-sm text-amber-700 mt-1">Add <code class="bg-amber-100 px-1 rounded">OpenAI:ApiKey</code> to <code class="bg-amber-100 px-1 rounded">appsettings.json</code> to enable AI report generation.</p>
            </div>
        </div>
    }

    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 mb-6">
        <div class="px-6 py-4 border-b border-slate-100">
            <h2 class="font-semibold text-slate-800">Filters</h2>
        </div>
        <form method="post" class="px-6 py-5">
            @Html.AntiForgeryToken()
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">Technician <span class="text-red-400">*</span></label>
                    <select name="TechnicianId" asp-items="Model.TechnicianList"
                            class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400 bg-white" required></select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">From date</label>
                    <input type="date" name="FromDate" value="@(Model.FromDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.AddDays(-30).ToString("yyyy-MM-dd"))"
                           class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-500 mb-1">To date</label>
                    <input type="date" name="ToDate" value="@(Model.ToDate?.ToString("yyyy-MM-dd") ?? DateTime.UtcNow.ToString("yyyy-MM-dd"))"
                           class="w-full border border-slate-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-400" />
                </div>
            </div>
            <div class="mt-5 flex items-center gap-3">
                <button type="submit"
                        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-700 text-white text-sm font-semibold transition-colors shadow-sm @(!Model.GptConfigured ? "opacity-50 cursor-not-allowed" : "")"
                        @(!Model.GptConfigured ? "disabled" : "")>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                    Generate Report
                </button>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-page="/AI/Prompts/Index" class="text-sm text-slate-500 hover:text-emerald-600 transition-colors">Manage prompts</a>
                }
            </div>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="bg-red-50 border border-red-200 rounded-xl p-4 mb-6 flex items-start gap-3">
            <svg class="w-5 h-5 text-red-500 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            <p class="text-sm text-red-700">@Model.ErrorMessage</p>
        </div>
    }

    @if (Model.Generated && !string.IsNullOrEmpty(Model.ReportText))
    {
        <div class="bg-white rounded-2xl shadow-soft border border-slate-100">
            <div class="px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <h2 class="font-semibold text-slate-800">AI-Generated Technician Report</h2>
                </div>
                <span class="text-xs text-slate-400">Generated @DateTime.UtcNow.ToString("yyyy-MM-dd HH:mm") UTC</span>
            </div>
            <div class="px-6 py-5 prose prose-slate max-w-none text-sm leading-relaxed">
                @Html.Raw(RenderMarkdown(Model.ReportText))
            </div>
        </div>
    }
</div>

@functions {
    static string RenderMarkdown(string text)
    {
        if (string.IsNullOrWhiteSpace(text)) return "";
        var html = System.Web.HttpUtility.HtmlEncode(text);

        html = System.Text.RegularExpressions.Regex.Replace(html, @"^### (.+)$", "<h3 class=\"text-base font-semibold text-slate-700 mt-4 mb-1\">$1</h3>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^## (.+)$", "<h2 class=\"text-lg font-bold text-slate-800 mt-5 mb-2\">$1</h2>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^# (.+)$", "<h1 class=\"text-xl font-extrabold text-slate-900 mt-6 mb-2\">$1</h1>", System.Text.RegularExpressions.RegexOptions.Multiline);

        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        html = System.Text.RegularExpressions.Regex.Replace(html, @"^[-•] (.+)$", "<li class=\"ml-4 list-disc text-slate-600\">$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^  [-•] (.+)$", "<li class=\"ml-8 list-disc text-slate-500\">$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html, @"^\d+\. (.+)$", "<li class=\"ml-4 list-decimal text-slate-600\">$1</li>", System.Text.RegularExpressions.RegexOptions.Multiline);

        html = System.Text.RegularExpressions.Regex.Replace(html, @"\n\n+", "</p><p class=\"mt-3 text-slate-600\">");
        html = "<p class=\"text-slate-600\">" + html + "</p>";
        html = html.Replace("\n", "<br/>");

        return html;
    }
}
