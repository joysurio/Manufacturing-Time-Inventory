@page
@model ManufacturingTimeTracking.Pages.Suppliers.DeleteModel
@{
    ViewData["Title"] = "Delete Supplier";
}

<div class="animate-fade-in w-full">
    <h1 class="text-2xl font-bold text-slate-800 mb-2">Delete Supplier</h1>
    <p class="text-slate-500 mb-6">Are you sure you want to delete this supplier? Materials linked to this supplier will have their supplier cleared.</p>
    <div class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6 mb-6 max-w-md mx-auto">
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div><dt class="text-sm font-medium text-slate-500">Name</dt><dd class="font-medium text-slate-800">@Model.Supplier.Name</dd></div>
            <div><dt class="text-sm font-medium text-slate-500">Code</dt><dd class="font-medium text-slate-800">@(Model.Supplier.Code ?? "—")</dd></div>
        </dl>
    </div>
    <form method="post" class="flex gap-3">
        <div class="m-auto">
            <input type="hidden" asp-for="Supplier.Id" />
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-red-600 text-white font-medium hover:bg-red-700 shadow-md transition-all duration-200">Delete</button>
            <a asp-page="./Index" class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-all duration-200">Back to List</a>
        </div>
    </form>
</div>
