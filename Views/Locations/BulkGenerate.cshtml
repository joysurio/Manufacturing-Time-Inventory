@model ManufacturingTimeTracking.Controllers.LocationsController.BulkGenerateVm
@{
    ViewData["Title"] = "Bulk generate locations";
}
<div class="animate-fade-in max-w-4xl mx-auto">
    <h2 class="text-2xl font-bold text-slate-800 mb-4">Bulk generate locations (XY)</h2>

    <div class="rounded-xl bg-blue-50 text-blue-800 border border-blue-200 px-4 py-3 mb-6">
        Generates codes like: <code class="px-1.5 py-0.5 rounded bg-blue-100">Z1-X01-Y01</code> (and optional <code class="px-1.5 py-0.5 rounded bg-blue-100">-Z01</code>). Use type "Workstation" for production stations.
    </div>

    <form method="post" class="bg-white rounded-2xl shadow-soft border border-slate-100 p-6">
        @Html.AntiForgeryToken()

        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Zone</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="Zone" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Type</label>
                <select class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="Type">
                    <option value="Shelf">Shelf</option>
                    <option value="Workstation">Workstation</option>
                    <option value="Reception">Reception</option>
                    <option value="Output">Output</option>
                    <option value="Quarantine">Quarantine</option>
                </select>
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Capacity (units)</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="CapacityUnits" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">X from</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="XFrom" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">X to</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="XTo" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Y from</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="YFrom" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Y to</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="YTo" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Z from (0=no Z)</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="ZFrom" />
            </div>
            <div>
                <label class="block text-sm font-medium text-slate-700 mb-1">Z to</label>
                <input class="w-full px-3 py-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-blue-500 focus:border-blue-500" asp-for="ZTo" />
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="rounded-xl bg-red-50 text-red-800 border border-red-200 px-4 py-3 mt-4">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@err.ErrorMessage</div>
                }
            </div>
        }

        <div class="flex gap-3 mt-6">
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-blue-600 text-white font-medium hover:bg-blue-700 transition-colors">Generate</button>
            <a class="px-5 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-medium hover:bg-slate-50 transition-colors" asp-action="Index">Back</a>
        </div>
    </form>
</div>
