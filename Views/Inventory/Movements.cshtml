                            <div class="movements-filter-popover absolute left-1/2 -translate-x-1/2 top-full mt-1 min-w-[200px] p-3 bg-slate-100 border border-slate-300 rounded-lg shadow-lg hidden" id="popover-itToLocation" data-params="itToLocation">
                                <input type="text" data-param="itToLocation" placeholder="Search to location" class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded" />
                                <div class="flex gap-1 mt-2">
                                    <button type="button" class="movements-filter-search px-2 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
                                    <button type="button" class="movements-filter-reset px-2 py-1 text-sm bg-slate-200 rounded hover:bg-slate-300">Reset</button>
                                <a href="#" class="movements-filter-close block text-xs text-slate-500 mt-1">close</a>
                                </div>
                            </div>
                        </th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider relative">
                            <div class="flex items-center justify-center gap-1">
                                <span>User</span>
                                <button type="button" class="movements-filter-btn p-0.5 rounded hover:bg-slate-200 text-slate-500" data-popover="user2" title="Filter">🔍</button>
                            </div>
                            <div class="movements-filter-popover absolute left-1/2 -translate-x-1/2 top-full mt-1 min-w-[200px] p-3 bg-slate-100 border border-slate-300 rounded-lg shadow-lg hidden" id="popover-user2" data-params="user">
                                <input type="text" data-param="user" placeholder="Search user" class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded" />
                                <div class="flex gap-1 mt-2">
                                    <button type="button" class="movements-filter-search px-2 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
                                    <button type="button" class="movements-filter-reset px-2 py-1 text-sm bg-slate-200 rounded hover:bg-slate-300">Reset</button>
                                <a href="#" class="movements-filter-close block text-xs text-slate-500 mt-1">close</a>
                                </div>
                            </div>
                        </th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider relative">
                            <div class="flex items-center justify-center gap-1">
                                <span>Notes</span>
                                <button type="button" class="movements-filter-btn p-0.5 rounded hover:bg-slate-200 text-slate-500" data-popover="notes2" title="Filter">🔍</button>
                            </div>
                            <div class="movements-filter-popover absolute left-1/2 -translate-x-1/2 top-full mt-1 min-w-[200px] p-3 bg-slate-100 border border-slate-300 rounded-lg shadow-lg hidden" id="popover-notes2" data-params="notes">
                                <input type="text" data-param="notes" placeholder="Search notes" class="w-full px-2 py-1.5 text-sm border border-slate-300 rounded" />
                                <div class="flex gap-1 mt-2">
                                    <button type="button" class="movements-filter-search px-2 py-1 text-sm bg-blue-600 text-white rounded hover:bg-blue-700">Search</button>
                                    <button type="button" class="movements-filter-reset px-2 py-1 text-sm bg-slate-200 rounded hover:bg-slate-300">Reset</button>
                                <a href="#" class="movements-filter-close block text-xs text-slate-500 mt-1">close</a>
                                </div>
                            </div>
                        </th>
                        <th class="px-6 py-4 text-center text-xs font-semibold text-slate-500 uppercase tracking-wider">Acciones</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-700">
                    @foreach (var m in Model.ItemMovements)
                    {
                        <tr class="transition-colors duration-150 hover:bg-slate-800/40">
                            <td class="px-6 py-4 text-center text-slate-200">@TimeZoneInfo.ConvertTimeFromUtc(m.TimestampUtc, displayTz).ToString("yyyy-MM-dd HH:mm")</td>
                            <td class="px-6 py-4 text-center font-medium text-white">@m.Type</td>
                            <td class="px-6 py-4 text-center text-slate-200">@m.Item?.Sku</td>
                            <td class="px-6 py-4 text-center text-white">@m.Item?.Name</td>
                            <td class="px-6 py-4 text-center text-slate-200">@m.Quantity</td>
                            <td class="px-6 py-4 text-center text-slate-200">@(m.FromLocation?.Code ?? "—")</td>
                            <td class="px-6 py-4 text-center text-slate-200">@(m.ToLocation?.Code ?? "—")</td>
                            <td class="px-6 py-4 text-center text-slate-200">@m.PerformedBy</td>
                            <td class="px-6 py-4 text-center text-slate-300">@(m.Notes ?? "—")</td>
                            <td class="px-6 py-4 text-center">
                                <form method="post" asp-action="DeleteItemMovement" asp-controller="Inventory" class="inline" onsubmit="return confirm('Delete this movement?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@m.Id" />
                                    <button type="submit" class="inline-flex items-center justify-center w-10 h-10 rounded-xl delete-btn" aria-label="Delete movement">
                                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M10 11v6M14 11v6M5 6l1 14a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2l1-14" /></svg>
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (pagination != null)
    {
        <partial name="~/Pages/Shared/_Pagination.cshtml" model="pagination" />
    }
    </div>
</div>

<style>
    /* Keep filter popovers on top of table, overflow, and other sections (e.g. when table is empty) */
    .movements-filter-popover {
        z-index: 9999;
    }
</style>

<script>
(function () {
    function getQueryParams() {
        var search = window.location.search || '';
        var params = {};
        if (search.charAt(0) === '?') search = search.slice(1);
        search.split('&').forEach(function (part) {
            var eq = part.indexOf('=');
            var key = eq >= 0 ? decodeURIComponent(part.slice(0, eq).replace(/\+/g, ' ')) : decodeURIComponent(part.replace(/\+/g, ' '));
            var val = eq >= 0 ? decodeURIComponent(part.slice(eq + 1).replace(/\+/g, ' ')) : '';
            if (key) params[key] = val;
        });
        return params;
    }
    function buildUrl(params) {
        var base = window.location.pathname;
        var parts = [];
        for (var k in params) {
            if (params[k] !== '' && params[k] != null)
                parts.push(encodeURIComponent(k) + '=' + encodeURIComponent(params[k]));
        }
        return base + (parts.length ? '?' + parts.join('&') : '');
    }
    function fillPopoverFromUrl(popover) {
        var params = getQueryParams();
        var paramStr = popover.getAttribute('data-params') || '';
        paramStr.split(',').forEach(function (p) {
            p = p.trim();
            var input = popover.querySelector('[data-param="' + p + '"]');
            if (input) input.value = params[p] || '';
        });
    }
    function openPopover(btn) {
        var id = btn.getAttribute('data-popover');
        var popover = document.getElementById('popover-' + id);
        if (!popover) return;
        document.querySelectorAll('.movements-filter-popover').forEach(function (p) { p.classList.add('hidden'); });
        fillPopoverFromUrl(popover);
        popover.classList.remove('hidden');
        popover.style.position = 'fixed';
        popover.style.zIndex = '9999';
        popover.style.transform = 'none';
        var rect = btn.getBoundingClientRect();
        requestAnimationFrame(function () {
            var w = popover.offsetWidth;
            var left = rect.left + (rect.width / 2) - (w / 2);
            if (left < 8) left = 8;
            if (left + w > window.innerWidth - 8) left = window.innerWidth - w - 8;
            popover.style.left = left + 'px';
            popover.style.top = (rect.bottom + 4) + 'px';
        });
    }
    function closeAllPopovers() {
        document.querySelectorAll('.movements-filter-popover').forEach(function (p) { p.classList.add('hidden'); });
    }
    function applySearch(popover) {
        var params = getQueryParams();
        var paramStr = popover.getAttribute('data-params') || '';
        paramStr.split(',').forEach(function (p) {
            p = p.trim();
            var input = popover.querySelector('[data-param="' + p + '"]');
            if (input) params[p] = (input.value || '').trim();
        });
        window.location.href = buildUrl(params);
    }
    function applyReset(popover) {
        var params = getQueryParams();
        var paramStr = popover.getAttribute('data-params') || '';
        paramStr.split(',').forEach(function (p) {
            p = p.trim();
            delete params[p];
        });
        window.location.href = buildUrl(params);
    }
    document.querySelectorAll('.movements-filter-btn').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.stopPropagation();
            var id = btn.getAttribute('data-popover');
            var popover = document.getElementById('popover-' + id);
            if (popover && popover.classList.contains('hidden')) {
                openPopover(btn);
            } else {
                closeAllPopovers();
            }
        });
    });
    document.querySelectorAll('.movements-filter-search').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var popover = btn.closest('.movements-filter-popover');
            if (popover) applySearch(popover);
        });
    });
    document.querySelectorAll('.movements-filter-reset').forEach(function (btn) {
        btn.addEventListener('click', function (e) {
            e.preventDefault();
            var popover = btn.closest('.movements-filter-popover');
            if (popover) applyReset(popover);
        });
    });
    document.querySelectorAll('.movements-filter-close').forEach(function (a) {
        a.addEventListener('click', function (e) {
            e.preventDefault();
            closeAllPopovers();
        });
    });
    document.addEventListener('click', function () { closeAllPopovers(); });
    document.querySelectorAll('.movements-filter-popover').forEach(function (p) {
        p.addEventListener('click', function (e) { e.stopPropagation(); });
    });
})();
</script>
